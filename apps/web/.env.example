# Data source for the storefront repositories.
# "json" (default) reads bundled data/*.json. "http" reads from the NestJS API.
DATA_SOURCE="json"

# Base URL of the NestJS API (used when DATA_SOURCE=http).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Supabase (admin login, Phase 4) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
