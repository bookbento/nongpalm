# Data source for the storefront repositories.
# "json" (default) reads bundled data/*.json. "http" reads from the NestJS API.
DATA_SOURCE="json"

# Base URL of the NestJS API (used when DATA_SOURCE=http).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Shared secret for the /api/revalidate hook. Must match REVALIDATE_SECRET in
# the API. Leave empty to disable on-demand revalidation (route returns 503).
REVALIDATE_SECRET=""
